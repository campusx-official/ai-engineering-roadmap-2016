---
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const inDays = path.startsWith('/100-days');
---

<header class="hdr no-print">
  <div class="wrap hdr__inner">
    <a class="hdr__brand" href="/" aria-label="AI Engineering Roadmap by CampusX, home">
      <span class="hdr__mark"><Icon name="route" size={17} /></span>
      <span class="hdr__names">
        <span class="hdr__name">AI Engineering Roadmap</span>
        <span class="hdr__by">by CampusX</span>
      </span>
    </a>

    <nav class="hdr__nav" aria-label="Primary">
      <a class="hdr__link" href="/" aria-current={!inDays ? 'page' : undefined} data-track="nav_full_roadmap">
        The Full <span class="hdr__tail">Roadmap</span>
      </a>
      <a class="hdr__link" href="/100-days/" aria-current={inDays ? 'page' : undefined} data-track="nav_100_days">
        Accelerated <span class="hdr__tail">Roadmap</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .hdr { border-bottom: 1px solid var(--cx-border); background: #fff; }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 14px;
  }

  .hdr__brand { display: flex; align-items: center; gap: 11px; margin-right: auto; }

  .hdr__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    background: var(--cx-grad);
    color: #fff;
  }

  .hdr__names { display: flex; flex-direction: column; line-height: 1.15; }
  .hdr__name {
    font-family: var(--cx-font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--cx-ink);
  }
  .hdr__by {
    font-family: var(--cx-font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cx-g500);
  }

  .hdr__nav { display: flex; align-items: center; gap: 26px; }

  .hdr__link {
    position: relative;
    font-size: 14.5px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--cx-g600);
    transition: color 0.16s ease;
  }
  .hdr__link:hover { color: var(--cx-purple); }
  .hdr__link[aria-current='page'] { color: var(--cx-ink); font-weight: 600; }
  .hdr__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: var(--cx-purple);
  }

  /* On a phone each name wraps onto two lines rather than squeezing the brand. */
  @media (max-width: 640px) {
    .hdr__inner { gap: 14px; }
    .hdr__nav { gap: 16px; }
    .hdr__link { font-size: 13px; line-height: 1.3; text-align: right; }
    .hdr__tail { display: block; }
    .hdr__link[aria-current='page']::after { bottom: -4px; }
  }
  /* Too narrow for the brand name too: keep the mark, which still links home. */
  @media (max-width: 520px) { .hdr__names { display: none; } }

</style>
