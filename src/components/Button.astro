---
import Icon from './Icon.astro';

interface Props {
  /** Forwarded to the root element (carries Astro's scope attribute). */
  [key: string]: unknown;
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  external?: boolean;
  /** Analytics event name fired on click (see src/scripts/app.ts). */
  track?: string;
  trackData?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'right',
  external = false,
  track,
  trackData,
  class: className = '',
  ...rest
} = Astro.props;
---

<a
  {...rest}
  href={href}
  class={`btn btn--${variant} btn--${size} ${className}`}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-track={track}
  data-track-data={trackData}
>
  {icon && iconPosition === 'left' && <Icon name={icon} size={17} />}
  <span><slot /></span>
  {icon && iconPosition === 'right' && <Icon name={icon} size={17} class="btn__ico-r" />}
  {external && !icon && <Icon name="arrow-up-right" size={16} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-radius: var(--cx-r-pill);
    font-family: var(--cx-font-body);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: background-color 0.18s ease, border-color 0.18s ease,
      box-shadow 0.18s ease, transform 0.18s ease;
  }
  .btn--md { padding: 13px 24px; font-size: 15px; }
  .btn--lg { padding: 17px 32px; font-size: 16.5px; }

  .btn--primary {
    background: var(--cx-purple);
    color: #fff;
    box-shadow: var(--cx-shadow-btn);
  }
  .btn--primary:hover { background: var(--cx-purple-hover); }

  .btn--secondary {
    background: #fff;
    color: var(--cx-ink);
    border-color: var(--cx-border);
  }
  .btn--secondary:hover { border-color: var(--cx-purple); color: var(--cx-purple); }

  .btn--ghost { background: transparent; color: var(--cx-g600); padding-inline: 12px; }
  .btn--ghost:hover { color: var(--cx-purple); }

  .btn__ico-r { transition: transform 0.18s ease; }
  .btn:hover .btn__ico-r { transform: translateX(2px); }

  @media (prefers-reduced-motion: reduce) {
    .btn, .btn__ico-r { transition: none; }
    .btn:hover .btn__ico-r { transform: none; }
  }
</style>
