---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ModuleRow from '../../components/ModuleRow.astro';
import ShipItCallout from '../../components/ShipItCallout.astro';
import CourseCard from '../../components/CourseCard.astro';
import LevelNav from '../../components/LevelNav.astro';
import StickyLevelNav from '../../components/StickyLevelNav.astro';
import Button from '../../components/Button.astro';
import { coursesFor, booksFor, CAMPUSX_ONE_URL } from '../../data/courses';
import {
  levels,
  phases,
  phaseOfLevel,
  capstonesOf,
  teachingModules,
  getLevel,
  cumulativeSessions,
  sentence,
  totalSessions,
  type Level,
} from '../../data/levels';
import { shortVersionOfLevel, coveredInModule, daysModuleHref } from '../../data/hundred-days';
import WeightCard from '../../components/WeightCard.astro';
import { interviewWeights, jobWeights, WEIGHT_MAX } from '../../data/level-weights';

export function getStaticPaths() {
  return levels.map((level) => ({
    params: { n: String(level.number) },
    props: { level },
  }));
}

interface Props { level: Level; }
const { level } = Astro.props;

const phase = phaseOfLevel(level.number);
const phaseIndex = phases.findIndex((p) => p.id === phase.id);
const capstones = capstonesOf(level);
const modules = teachingModules(level);
const courses = coursesFor(level.number);
const books = booksFor(level.number);
const cumulative = cumulativeSessions(level.number);
const cumulativePct = Math.round((cumulative / totalSessions) * 100);
const levelPct = Math.round((level.totalSessions / totalSessions) * 100);

/* One link per level this one assumes. Most assume the previous level, but a
   stated Prerequisites line can name several, none of them adjacent (Level 13
   assumes 1, 7 and 11, not 12). A level that assumes nothing says so. */
const prereqs = level.prerequisites
  .map((n) => getLevel(n))
  .filter((l): l is NonNullable<typeof l> => Boolean(l));

/* A level with a compressed version in 100 Days of AI Engineering points to it. */
const shortVersion = shortVersionOfLevel(level.number);
const coveredIn = shortVersion ? undefined : coveredInModule(level.number);

/* How much this level counts, for getting hired and for doing the job. */
const interviewWeight = interviewWeights[level.number];
const jobWeight = jobWeights[level.number];

const description = `Level ${level.number} of the CampusX AI Engineering Roadmap: ${level.scope}`.slice(0, 300);
---

<Base
  title={`Level ${level.number} · ${level.title} — AI Engineering Roadmap`}
  description={description}
  page="level"
  levelNumber={level.number}
  ogImage={`/og/level-${level.number}.png`}
>
  <Fragment slot="head">
    {/* Maintainer note: fields the source .txt did not provide. */}
    {level.todos.length > 0 && (
      <Fragment set:html={`<!-- TODO (${level.sourceFile}): ${level.todos.join(' | ')} -->`} />
    )}
  </Fragment>

  <Fragment slot="subnav">
    <StickyLevelNav level={level} />
  </Fragment>

  <article data-phase={phase.id}>
    <!-- ───────────────── header ───────────────── -->
    <header class="lh">
      <div class="wrap lh__inner">
        <div class="lh__crumbs">
          <a href="/#map" class="lh__crumb">Roadmap</a>
          <Icon name="chevron-right" size={13} />
          <span class="lh__crumb lh__crumb--phase">{phase.name}</span>
        </div>

        <div class="lh__top">
          <span class="lh__num" aria-hidden="true">{level.number}</span>
          <div class="lh__headings">
            <Eyebrow text={`Phase ${phaseIndex + 1} · ${phase.name}`} class="lh__eyebrow" />
            <h1 class="h1 lh__title">{level.title}</h1>
          </div>
        </div>

        <p class="lede lh__scope">{sentence(level.scope)}</p>

        {shortVersion && (
          <a class="lh__short" href={daysModuleHref(shortVersion)} data-track="level_short_version" data-track-data={String(level.number)}>
            <Icon name="calendar-days" size={15} />
            <span>
              Short on time? Do the {shortVersion.days[1] - shortVersion.days[0] + 1}-day version in
              <b>100 Days of AI Engineering</b>
            </span>
            <Icon name="arrow-right" size={14} class="lh__short-go" />
          </a>
        )}

        {coveredIn && (
          <a class="lh__short" href={daysModuleHref(coveredIn.module)} data-track="level_covered_in" data-track-data={String(level.number)}>
            <Icon name="calendar-days" size={15} />
            <span>
              {coveredIn.topic} {coveredIn.plural ? 'are' : 'is'} covered inside the {coveredIn.module.title} module of
              <b>100 Days of AI Engineering</b>
            </span>
            <Icon name="arrow-right" size={14} class="lh__short-go" />
          </a>
        )}

        {(interviewWeight || jobWeight) && (
          <div class="lh__weights">
            {interviewWeight && (
              <WeightCard title="Interview weight" icon="briefcase-business" score={interviewWeight.score} max={WEIGHT_MAX} reason={interviewWeight.reason} />
            )}
            {jobWeight && (
              <WeightCard title="On-the-job weight" icon="wrench" score={jobWeight.score} max={WEIGHT_MAX} reason={jobWeight.reason} />
            )}
          </div>
        )}

        <div class="lh__facts">
          <div class="lh__fact">
            <span class="lh__fact-label">This level</span>
            <span class="lh__prog" role="img" aria-label={`${level.totalSessions} of ${totalSessions} sessions in the roadmap`}>
              <span class="lh__prog-fill" style={`width:${levelPct}%`}></span>
            </span>
            <span class="lh__fact-value">{level.totalSessions} of {totalSessions} sessions ({levelPct}%)</span>
          </div>

          <div class="lh__fact">
            <span class="lh__fact-label">Cumulative</span>
            <span class="lh__prog">
              <span class="lh__prog-fill" style={`width:${cumulativePct}%`}></span>
            </span>
            <span class="lh__fact-value">{cumulative} of {totalSessions} sessions ({cumulativePct}%)</span>
          </div>

          <div class="lh__fact lh__fact--pre">
            <span class="lh__fact-label">Assumes</span>
            {prereqs.length > 0 ? (
              <ul class="lh__pres" role="list">
                {prereqs.map((p) => (
                  <li>
                    <a class="lh__pre" href={`/level/${p.number}/`} data-track="prereq_click" data-track-data={String(p.number)}>
                      <Icon name="corner-left-up" size={14} />
                      <span>Level {p.number} · {p.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <span class="lh__pre lh__pre--none">
                <Icon name="flag-triangle-right" size={14} />
                <span>{level.number === 0 ? 'Nothing — this is the start' : level.prereqStated}</span>
              </span>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- ───────────────── module map ───────────────── -->
    <section class="section lsec" aria-labelledby="modules-h">
      <div class="wrap">
        <h2 class="lsec__label" id="modules-h">
          <span class="lsec__label-ico"><Icon name="list-ordered" size={18} /></span>
          <span>Modules</span>
          <span class="lsec__label-count">{level.modules.length}</span>
        </h2>
        <div class="mods">
          {level.modules.map((m, i) => (
            <ModuleRow module={m} index={i} levelNumber={level.number} />
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────────── ship it ───────────────── -->
    {capstones.length > 0 && (
      <section class="section lsec lsec--tight" id="ship">
        <div class="wrap ship-stack">
          {capstones.map((c) => (
            <ShipItCallout module={c} levelNumber={level.number} />
          ))}
        </div>
      </section>
    )}

    <!-- ───────────────── campusx ───────────────── -->
    <section class="section lsec courses" aria-labelledby="courses-h">
      <div class="wrap">
        <SectionHeader
          eyebrow="Learn this on CampusX"
          title={courses.length > 0 ? 'Courses that cover this level.' : 'No direct course mapping yet.'}
          subhead={
            courses.length > 0
              ? 'Included with CampusX One. Items marked coming soon are still in production.'
              : 'This level has no mapped catalog item yet — CampusX One is still the place to ask questions while you work through it.'
          }
          class="lsec__head"
        />

        {courses.length > 0 && (
          <ul class="courses__grid" id="courses-h" role="list">
            {courses.map((c) => (
              <li><CourseCard course={c} levelNumber={level.number} /></li>
            ))}
          </ul>
        )}

        {books.length > 0 && (
          <div class="reading">
            <h3 class="reading__label">
              <Icon name="book-marked" size={14} />
              <span>Further reading</span>
            </h3>
            <ul class="reading__list" role="list">
              {books.map((book) => {
                const Tag = book.url ? 'a' : 'div';
                return (
                  <li>
                    <Tag
                      class="reading__item"
                      href={book.url}
                      target={book.url ? '_blank' : undefined}
                      rel={book.url ? 'noopener noreferrer' : undefined}
                      data-track={book.url ? 'reading_click' : undefined}
                      data-track-data={book.url ? `${level.number}:${book.title}` : undefined}
                    >
                      <span class="reading__title">{book.title}</span>
                      <span class="reading__author">{book.author}</span>
                      {book.url && <Icon name="arrow-up-right" size={14} class="reading__go" />}
                    </Tag>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <div class="courses__cta">
          <Button
            href={CAMPUSX_ONE_URL}
            variant="primary"
            external
            track="campusx_cta_click"
            trackData={`level_${level.number}`}
          >
            Open CampusX One
          </Button>
        </div>
      </div>
    </section>

    <!-- ───────────────── nav ───────────────── -->
    <section class="section lsec lnav-section no-print">
      <div class="wrap">
        <LevelNav current={level.number} />
      </div>
    </section>
  </article>
</Base>

<style>
  /* ---------- header ---------- */
  .lh {
    padding-block: 40px 34px;
    background: linear-gradient(180deg, var(--phase-bg) 0%, #fff 100%);
  }
  @media (min-width: 768px) { .lh { padding-block: 56px 44px; } }

  .lh__inner { display: flex; flex-direction: column; gap: 18px; }

  .lh__crumbs {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: var(--cx-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cx-g500);
  }
  .lh__crumb:hover { color: var(--cx-purple); }
  .lh__crumb--phase { color: var(--phase-ac); }

  .lh__top { display: flex; align-items: flex-start; gap: 16px; }
  @media (min-width: 768px) { .lh__top { gap: 24px; align-items: center; } }

  .lh__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: 20px;
    background: #fff;
    border: 2px solid var(--phase-br);
    color: var(--phase-ac);
    font-family: var(--cx-font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--cx-shadow-card);
  }
  @media (min-width: 768px) { .lh__num { width: 88px; height: 88px; font-size: 42px; border-radius: 26px; } }

  .lh__headings { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .lh__eyebrow { color: var(--phase-ac) !important; }
  .lh__title { font-size: clamp(30px, 6vw, 62px); }

  .lh__scope { max-width: 62ch; }

  .lh__weights { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 820px) { .lh__weights { grid-template-columns: 1fr 1fr; gap: 18px; } }

  .lh__short {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--phase-br);
    font-size: 14px;
    line-height: 1.4;
    color: var(--cx-g700);
    transition: border-color 0.16s ease;
  }
  .lh__short :global(svg) { flex: none; color: var(--phase-ac); }
  .lh__short b { font-weight: 600; color: var(--phase-ac); }
  .lh__short:hover { border-color: var(--phase-ac); }
  @media (prefers-reduced-motion: reduce) { .lh__short { transition: none; } }

  .lh__facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 8px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid var(--phase-br);
    border-radius: var(--cx-r-card);
  }
  @media (min-width: 820px) {
    .lh__facts { grid-template-columns: repeat(3, 1fr); gap: 26px; padding: 20px 24px; }
  }

  .lh__fact { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .lh__fact-label {
    font-family: var(--cx-font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cx-g500);
  }
  .lh__fact-value {
    font-family: var(--cx-font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--cx-g700);
    font-variant-numeric: tabular-nums;
  }

  .lh__prog { display: block; height: 6px; border-radius: 999px; background: var(--cx-border-2); overflow: hidden; }
  .lh__prog-fill { display: block; height: 100%; border-radius: 999px; background: var(--phase-ac); opacity: 0.85; }

  .lh__pres { display: flex; flex-direction: column; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .lh__pre {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--phase-ac);
    line-height: 1.4;
  }
  .lh__pre:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lh__pre--none { color: var(--cx-g500); }
  .lh__pre--none:hover { text-decoration: none; }

  /* ---------- sections ---------- */
  .lsec { padding-block: 44px; }
  @media (min-width: 768px) { .lsec { padding-block: 56px; } }
  .lsec--tight { padding-block: 22px; }
  .lsec__head { margin-bottom: 26px; max-width: 640px; }
  .lsec__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 30px;
    font-family: var(--cx-font-display);
    font-size: clamp(24px, 3vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--cx-ink);
  }
  .lsec__label-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--phase-bg);
    border: 1px solid var(--phase-br);
    color: var(--phase-ac);
  }
  .lsec__label-count {
    padding: 2px 9px;
    border-radius: 999px;
    background: var(--phase-bg);
    border: 1px solid var(--phase-br);
    color: var(--phase-ac);
    font-family: var(--cx-font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .mods { border-radius: var(--cx-r-card); overflow: hidden; }


  .ship-stack { display: flex; flex-direction: column; gap: 16px; }

  /* ---------- courses ---------- */
  .courses__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 620px) { .courses__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .courses__grid { grid-template-columns: repeat(3, 1fr); } }

  .courses__cta { margin-top: 22px; }

  /* ---------- further reading ---------- */
  /* Visually quieter than a course card: this is a pointer to someone else's
     work, not a CampusX catalog item. */
  .reading { margin-top: 26px; }

  .reading__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    font-family: var(--cx-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cx-g500);
  }

  .reading__list { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }

  .reading__item {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 11px 16px;
    border: 1px dashed var(--cx-border-2);
    border-radius: var(--cx-r-card-sm);
    background: var(--cx-gray);
  }
  a.reading__item { transition: border-color 0.18s ease, background-color 0.18s ease; }
  a.reading__item:hover { border-color: var(--cx-purple); background: #fff; }

  .reading__title {
    font-family: var(--cx-font-display);
    font-weight: 700;
    font-size: 14.5px;
    letter-spacing: -0.01em;
    color: var(--cx-ink);
  }
  .reading__author { font-size: 13px; color: var(--cx-g600); }
  .reading__go { align-self: center; color: var(--cx-g500); }

  @media (prefers-reduced-motion: reduce) { a.reading__item { transition: none; } }

  .lnav-section { padding-top: 12px; padding-bottom: 72px; }
</style>
